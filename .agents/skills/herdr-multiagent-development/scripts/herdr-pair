#!/usr/bin/env bash
# Manage 1-1 Worker-N and Censor-N pair lifecycles on Herdr.
#
# Usage:
#   herdr-pair create <TASK_NUMBER>
#   herdr-pair close <TASK_NUMBER>
set -euo pipefail

test "${HERDR_ENV:-}" = 1 || { echo "Error: Not running inside Herdr environment (HERDR_ENV != 1)" >&2; exit 1; }

ACTION=${1:-}
N=${2:-}

[ -n "$ACTION" ] && [ -n "$N" ] || {
  echo "Usage: $0 {create|close} <TASK_NUMBER>" >&2
  exit 2
}

WORKSPACE_DIR=$(git rev-parse --show-toplevel)/.superpowers/sdd
PAIR_STATE_FILE="$WORKSPACE_DIR/pair-task-${N}.json"
mkdir -p "$WORKSPACE_DIR"

case "$ACTION" in
  create)
    echo ">> [Herdr Pair] Initializing pair for Task ${N}..."
    
    # 1. Create pane for Worker-N
    PANE_W=$(herdr pane split --current --direction down --cwd "$PWD" --no-focus | jq -r '.result.pane.pane_id')
    herdr agent start "worker-${N}" --kind omp --pane "$PANE_W"
    
    # 2. Create pane for paired Censor-N
    PANE_C=$(herdr pane split --pane "$PANE_W" --direction right --cwd "$PWD" --no-focus | jq -r '.result.pane.pane_id')
    herdr agent start "censor-${N}" --kind omp --pane "$PANE_C"
    
    # Record pane state metadata for subsequent teardown
    jq -n \
      --arg task "$N" \
      --arg pane_w "$PANE_W" \
      --arg agent_w "worker-${N}" \
      --arg pane_c "$PANE_C" \
      --arg agent_c "censor-${N}" \
      '{task: $task, worker: {pane_id: $pane_w, name: $agent_w}, censor: {pane_id: $pane_c, name: $agent_c}}' \
      > "$PAIR_STATE_FILE"
      
    echo ">> [Herdr Pair] Provisioned successfully:"
    echo "   Worker: worker-${N} (Pane: $PANE_W)"
    echo "   Censor: censor-${N} (Pane: $PANE_C)"
    echo "   Metadata: $PAIR_STATE_FILE"
    ;;
    
  close)
    echo ">> [Herdr Pair] Tearing down pair for Task ${N}..."
    if [ -f "$PAIR_STATE_FILE" ]; then
      PANE_W=$(jq -r '.worker.pane_id' "$PAIR_STATE_FILE")
      PANE_C=$(jq -r '.censor.pane_id' "$PAIR_STATE_FILE")
      
      herdr pane close "$PANE_W" 2>/dev/null || true
      herdr pane close "$PANE_C" 2>/dev/null || true
      rm -f "$PAIR_STATE_FILE"
      echo ">> [Herdr Pair] Successfully closed Pane $PANE_W and $PANE_C. Context is 100% clean."
    else
      echo "Warning: State file $PAIR_STATE_FILE not found." >&2
    fi
    ;;
    
  *)
    echo "Invalid command: $ACTION. Expected 'create' or 'close'." >&2
    exit 2
    ;;
esac
